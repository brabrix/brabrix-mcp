# Exemplo de Variáveis de Ambiente

# URL da API (Opcional, padrão é https://api.brabrix.com)
BRABRIX_API_URL=https://api.brabrix.com

# Seu token pessoal da Brabrix (Obrigatório para modo real)
# Obtenha em: https://brabrix.com/dev/tokens
BRABRIX_TOKEN=bbx_live_...

# ID do Projeto padrão (Opcional se usar .brabrix/config.json)
BRABRIX_PROJECT_ID=proj_...

# ID da Task padrão (Opcional se usar .brabrix/config.json)
BRABRIX_CURRENT_TASK_ID=task_...

# Raiz do workspace para detecção de config local (Opcional)
BRABRIX_WORKSPACE_ROOT=/users/dev/projects/meu-projeto
BRABRIX_MCP_ENABLE_WRITE_TOOLS=false
